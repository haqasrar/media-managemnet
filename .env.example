# ============================================================================
# FIREBASE CONFIGURATION (Google Auth + Cloud Storage 5GB Free Tier + Firestore)
# ============================================================================
# 1. Go to https://console.firebase.google.com and create a project.
# 2. Enable Authentication -> Sign-in method -> Google.
# 3. Enable Storage (choose us-central1, us-west1, or us-east1 for the 5 GB Free Tier).
# 4. Copy your web app config values into .env.local using the keys below.
# Note: Until these keys are set, the app automatically runs in Hybrid Local Storage
# mode so you can upload files, manage folders, and test Client Share Links right away!

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
